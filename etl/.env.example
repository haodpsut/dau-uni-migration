# =============================================================================
# SOURCE (SQL Server — vendor ASCVN legacy)
# =============================================================================
SOURCE_HOST=localhost
SOURCE_PORT=1433
SOURCE_USER=sa
SOURCE_PASSWORD=YourStrong@Pass1

# Tên 3 DB nguồn (đã restore từ .bak)
SOURCE_DB_HRM=HRM_DAU
SOURCE_DB_EDU=EDU_DAU
SOURCE_DB_DATA=EDU_DAU_DATA

# =============================================================================
# TARGET (Postgres mới)
# =============================================================================
TARGET_HOST=localhost
TARGET_PORT=5432
TARGET_DB=dau_university
TARGET_USER=dau_admin
TARGET_PASSWORD=YourStrong@Pass1

# =============================================================================
# MinIO (BLOB storage)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=YourStrong@Pass1
MINIO_SECURE=false

# Buckets được tự tạo nếu chưa có
MINIO_BUCKET_STUDENTS=students
MINIO_BUCKET_EMPLOYEES=employees
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_GRADE_CHANGES=grade-changes

# =============================================================================
# ETL config
# =============================================================================
# Batch size cho COPY — tăng lên cho RAM lớn
ETL_BATCH_SIZE=10000

# Truncate trước khi load (idempotent)
ETL_TRUNCATE_BEFORE_LOAD=true

# Audit migration: chỉ giữ N năm gần nhất (đặt 0 = giữ tất cả)
ETL_AUDIT_KEEP_YEARS=3

# Log level
LOG_LEVEL=INFO
LOG_FILE=logs/etl.log

# =============================================================================
# Auto-commit + auto-upload (sau khi ETL chạy xong)
# =============================================================================
# Để trống = SKIP auto-commit (user tự làm tay)

# GitHub auto-push report nhẹ
GITHUB_PAT=
GITHUB_REPO=haodpsut/dau-uni-migration
GIT_USER_EMAIL=haodp.ai@gmail.com
GIT_USER_NAME=Phuc Hao Do

# Google Drive auto-upload heavy output (pg_dump.gz, minio.tar.gz)
# Để trống = SKIP upload
GDRIVE_OUTPUT_PATH=gdrive:dau-uni-output
